# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/resumematch-pro

# Cashfree API Keys (from Cashfree dashboard → Developers → API Keys)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Frontend (Vite) environment variables
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_CASHFREE_ENV=sandbox   # change to "production" when going live
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Frontend URLs (for payment redirects)
FRONTEND_BASE_URL=http://localhost:3000
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success

# Server Port (optional)
PORT=8080
