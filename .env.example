# ResumeMatch Pro Configuration

# ResumeMatch Pro Backend API (set to your backend URL)
# For local development: http://localhost:8000
# For production: https://your-backend-url.com
VITE_API_URL=http://localhost:8000

# Google Gemini API (get from https://makersuite.google.com/app/apikey)
VITE_GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Atlas (Realm Web SDK)
VITE_MONGODB_REALM_APP_ID=your_mongodb_realm_app_id_here

# Extension Configuration
VITE_EXTENSION_MODE=false
