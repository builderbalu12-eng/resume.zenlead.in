{
  "manifest_version": 3,
  "name": "LandYourJob",
  "version": "1.0.0",
  "description": "AI-powered resume tailoring for any job post. Live ATS score, keyword gap analysis, and one-click tailoring on LinkedIn, Indeed, Naukri & 40+ job boards.",
  "homepage_url": "https://landyourjob.zenlead.in",
  "permissions": ["storage", "tabs", "scripting", "downloads", "sidePanel"],
  "host_permissions": [
    "https://*.zenlead.in/*",
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://*.indeed.com/*",
    "https://*.monster.com/*",
    "https://*.glassdoor.com/*",
    "https://*.dice.com/*",
    "https://*.ziprecruiter.com/*",
    "https://*.builtin.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "LandYourJob",
    "default_icons": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zenlead.in/*",
        "*://*.linkedin.com/*",
        "*://*.naukri.com/*",
        "*://*.indeed.com/*",
        "*://*.monster.com/*",
        "*://*.glassdoor.com/*",
        "*://*.dice.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.builtin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "sidebar.html"],
      "matches": [
        "*://*.zenlead.in/*",
        "*://*.linkedin.com/*",
        "*://*.naukri.com/*",
        "*://*.indeed.com/*",
        "*://*.monster.com/*",
        "*://*.glassdoor.com/*",
        "*://*.dice.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.builtin.com/*"
      ]
    }
  ]
}
